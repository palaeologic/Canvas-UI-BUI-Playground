  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
